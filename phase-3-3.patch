+                </span>
+              </li>
+            ))}
+          </ul>
+        )}
+      </section>
+
+      {/* Bookmarks */}
+      <section>
+        <h2 className="flex items-center gap-2 font-heading text-lg font-semibold text-text">
+          <Bookmark size={18} className="text-primary" aria-hidden="true" />
