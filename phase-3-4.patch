+      }
+    }
   }
 
   results.sort((a, b) => b.score - a.score || a.title.localeCompare(b.title));
   return results.slice(0, RESULT_LIMIT);
 }
 
+function matchesFilters(entry: SearchEntry, filters?: SearchFiltersPreference): boolean {
+  if (!filters) return true;
+  if (filters.papers && filters.papers.length > 0 && entry.paper && !filters.papers.includes(entry.paper)) return false;
+  if (filters.types && filters.types.length > 0 && entry.type && !filters.types.includes(entry.type)) return false;
+  if (filters.sections && filters.sections.length > 0 && entry.section && !filters.sections.includes(entry.section)) return false;
+  if (filters.years && filters.years.length > 0 && entry.year && !filters.years.includes(entry.year)) return false;
+  return true;
+}
